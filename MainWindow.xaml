<Window x:Class="SC4ModMigrationAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SC4 Mod Migration Assistant" Height="700" Width="1000" MinHeight="520" MinWidth="750"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ===================== Synthwave dark palette ===================== -->
        <Color x:Key="BgTopColor">#FF1B1330</Color>
        <Color x:Key="BgBottomColor">#FF241B3A</Color>
        <SolidColorBrush x:Key="PanelBrush" Color="#FF1B1626" />
        <SolidColorBrush x:Key="PanelLightBrush" Color="#FF2A2140" />
        <SolidColorBrush x:Key="PanelHoverBrush" Color="#FF352A52" />
        <SolidColorBrush x:Key="BorderAccentBrush" Color="#FF7B2FF7" />
        <SolidColorBrush x:Key="AccentPinkBrush" Color="#FFFF3CAC" />
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#FF22D3EE" />
        <SolidColorBrush x:Key="AccentAmberBrush" Color="#FFFFB86C" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF1EAFB" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9B8FC0" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#FF5C5478" />
        <SolidColorBrush x:Key="DisabledBorderBrush" Color="#FF453A63" />

        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource BgTopColor}" Offset="0" />
            <GradientStop Color="{StaticResource BgBottomColor}" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ProgressFillBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF3CAC" Offset="0" />
            <GradientStop Color="#FF7B2FF7" Offset="0.55" />
            <GradientStop Color="#FF22D3EE" Offset="1" />
        </LinearGradientBrush>

        <!-- ===================== Button ===================== -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelLightBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentPinkBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== TextBox ===================== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentCyanBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentPinkBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== ProgressBar ===================== -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource ProgressFillBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid ClipToBounds="True">
                                <Rectangle x:Name="PART_Track" Fill="Transparent" />
                                <Rectangle x:Name="PART_Indicator"
                                           Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left"
                                           RadiusX="3" RadiusY="3" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== ScrollBar (compact dark version) ===================== -->
        <Style x:Key="DarkScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource BorderAccentBrush}" CornerRadius="3" Margin="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== ListBox / ListBoxItem (log) ===================== -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PanelHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Plugins folder selection -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Plugins folder:" VerticalAlignment="Center" Margin="0,0,8,0"
                       FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBox Grid.Column="1" x:Name="TxtPluginsPath" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4" Height="28" />
            <Button Grid.Column="2" x:Name="BtnBrowse" Content="Browse..." Width="100" Padding="6" Margin="8,0,0,0" Click="BtnBrowse_Click" />
        </Grid>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnScan" Content="Scan TGIs" Width="160" Padding="6" Click="BtnScan_Click" IsEnabled="False" />
            <Button x:Name="BtnMoveDuplicates" Content="Move Duplicates" Width="150" Padding="6" Margin="10,0,0,0" Click="BtnMoveDuplicates_Click" IsEnabled="False" />
            <Button x:Name="BtnCheckCatalog" Content="Check sc4pac Catalog" Width="170" Padding="6" Margin="10,0,0,0" Click="BtnCheckCatalog_Click" IsEnabled="False" />
            <Button x:Name="BtnCancel" Content="Cancel" Width="90" Padding="6" Margin="10,0,0,0" Click="BtnCancel_Click" IsEnabled="False" />
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Scan progress bar -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Scanning" Width="80" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
            <ProgressBar Grid.Column="1" x:Name="ProgressBarScan" Minimum="0" Maximum="100" Value="0" />
            <TextBlock Grid.Column="2" x:Name="TxtProgressCount" Margin="10,0,0,0" VerticalAlignment="Center" Width="140"
                       TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
        </Grid>

        <!-- Comparison progress bar: only visible while the TGI comparison phase is running -->
        <Grid Grid.Row="3" Margin="0,0,0,10" x:Name="CompareProgressPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Comparing" Width="80" VerticalAlignment="Center"
                       Foreground="{StaticResource AccentCyanBrush}" FontSize="11" />
            <ProgressBar Grid.Column="1" x:Name="ProgressBarCompare" Minimum="0" Maximum="100" Value="0"
                         BorderBrush="{StaticResource AccentCyanBrush}" />
            <TextBlock Grid.Column="2" x:Name="TxtCompareCount" Margin="10,0,0,0" VerticalAlignment="Center" Width="220"
                       TextAlignment="Right" Foreground="{StaticResource AccentCyanBrush}" />
        </Grid>

        <!-- Log (virtualized list for performance with large plugin folders) -->
        <Border Grid.Row="4" BorderBrush="{StaticResource BorderAccentBrush}" BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="LogListBox"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                                   FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- sc4pac catalog matches: only visible after a "Check sc4pac Catalog" run finds packages -->
        <Border Grid.Row="5" x:Name="CatalogResultsPanel" Visibility="Collapsed" Margin="0,10,0,0"
                BorderBrush="{StaticResource AccentPinkBrush}" BorderThickness="1" CornerRadius="4" MaxHeight="220">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="sc4pac packages found for your override files:"
                           Foreground="{StaticResource AccentPinkBrush}" FontWeight="SemiBold" Margin="8,6,8,4" />
                <ListBox x:Name="CatalogResultsListBox" BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11">
                                        <Run Text="{Binding PackageId, Mode=OneWay}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding MatchingFiles.Count, Mode=OneWay}" />
                                        <Run Text=" local file(s), " />
                                        <Run Text="{Binding MatchedTgiCount, Mode=OneWay}" />
                                        <Run Text=" TGI(s)" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Copy ID" Padding="6,2" Margin="6,0,0,0"
                                        Click="BtnCopyPackageId_Click" Tag="{Binding}" />
                                <Button Grid.Column="2" Content="Copy sc4pac add" Padding="6,2" Margin="6,0,0,0"
                                        Click="BtnCopyAddCommand_Click" Tag="{Binding}" />
                                <Button Grid.Column="3" Content="Open Page" Padding="6,2" Margin="6,0,0,0"
                                        Click="BtnOpenPage_Click" Tag="{Binding}"
                                        Visibility="{Binding HasPageUrl, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Legend -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Legend:" FontWeight="Bold" Margin="0,0,10,0" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="■ Plugins" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" />
            <TextBlock Text="■ 075-my-plugins / 895-my-overrides" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,10,0" />
            <TextBlock Text="■ Duplicates" Foreground="{StaticResource AccentPinkBrush}" Margin="0,0,10,0" />
            <TextBlock Text="■ Warnings/errors" Foreground="{StaticResource AccentAmberBrush}" />
        </StackPanel>
    </Grid>
</Window>
